[Unit]
# serve.py arranca Waitress (instalado en .venv por scripts/setup-server.sh).
Description=arquitecturadeguardia Finance
After=network.target

[Service]
Type=simple
User=adg-finance
Group=adg-finance
WorkingDirectory=/opt/adg-finance
ExecStart=/opt/adg-finance/.venv/bin/python /opt/adg-finance/serve.py
Environment=ADG_PORT=4173
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/adg-finance/browsers
Environment=ADG_DATA_DIR=/var/lib/adg-finance
Environment=ADG_PUBLIC_ORIGIN=https://finance.empresa.es
Restart=on-failure
# SIGTERM deja terminar las peticiones en curso (hasta 5 s) antes de salir.
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/adg-finance

[Install]
WantedBy=multi-user.target
