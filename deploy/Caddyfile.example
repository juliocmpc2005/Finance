# Sustituir el dominio después de apuntar su DNS al servidor.
finance.empresa.es {
    # Caddy envía X-Forwarded-For con la dirección real del cliente; la aplicación solo la acepta desde 127.0.0.1.
    reverse_proxy 127.0.0.1:4173
    # Comprime las respuestas: los datos de facturación ocupan de 7 a 20 veces menos y los archivos .js/.css unas 4 veces menos.
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
}
